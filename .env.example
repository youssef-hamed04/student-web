# Backend API base URL including the global prefix (e.g. http://localhost:3000/api/v1).
# Server-side only — the browser never talks to the backend directly.
API_BASE_URL=http://localhost:3000/api/v1

# Request timeout in milliseconds (default: 20000)
API_TIMEOUT_MS=20000

# Whether session cookies carry the Secure flag (default: on in production, off in dev)
SECURE_COOKIES=false

# Allowed origin for mutating proxy requests (CSRF protection).
# Defaults to the request's own origin when unset.
# APP_ORIGIN=http://localhost:3002

# Platform timezone for date rendering (default: Africa/Cairo)
PLATFORM_TIMEZONE=Africa/Cairo
NEXT_PUBLIC_PLATFORM_TIMEZONE=Africa/Cairo

# Public app version shown in Settings → About
NEXT_PUBLIC_APP_VERSION=1.0.0
